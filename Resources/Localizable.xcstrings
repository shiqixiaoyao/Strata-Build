        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starta om LiveContainer för att installera appar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamaları yüklemek için lütfen LiveContainer'ı yeniden başlatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vui lòng mở lại LiveContainer để cài app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重启LiveContainer以安装App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請重新啟動LiveContainer 來安裝App。"
          }
        }
      }
    },
    "lc.helpView.text1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعداد وضع بدون-JIT في الإعدادات لاستخدام LiveContainer بدون JIT.\nتحقق من صفحة تشخيص بدون-JIT في الإعدادات إذا واجهت مشكلة في تفعيل وضع بدون-JIT.\nاضغط على زر الإضافة لتثبيت التطبيقات.\nاضغط مطولاً على التطبيق للوصول إلى إعدادات المحددة للتطبيق، وإصلاحات، وإضافة التطبيقات إلى الشاشة الرئيسية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richten Sie den JIT-freien-Modus in den Einstellungen ein, um LiveContainer ohne JIT zu verwenden.\n\n**Prüfen Sie die JITless-Diagnose-Seite in den Einstellungen, wenn Sie Probleme mit der Aktivierung des JIT-Less-Modus haben.**\n\nDrücken Sie die Plus-Taste, um Apps zu installieren.\n\nDrücken Sie lange auf die App, um app-spezifische Einstellungen, Fehlerbehebungen und das Hinzufügen von Apps zum Homescreen zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup JITLess mode in settings to use LiveContainer without JIT.\n\n**Check JITLess Diagnose page in settings if you have trouble enabling JITLess mode.**\n\nPress plus button to install apps.\n\nHolding app banner for app-specific settings, fixes and adding apps to home screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura el modo JITLess en los ajustes para usar LiveContainer sin JIT.\n\n**Consulta la página de diagnóstico JITLess en los ajustes si tienes problemas para activar el modo JITLess.**\n\nPulsa el botón más para instalar apps.\n\nMantén pulsado el banner de la app para acceder a los ajustes específicos, correcciones y añadirla a la pantalla de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurer le mode sans JIT dans les paramètres pour utiliser LiveContainer sans le JIT.\n\n**Consultez la page Diagnostic du mode sans JIT dans les paramètres si vous avez des difficultés à activer le mode sans JIT.\n\nAppuyez sur le bouton Plus pour installer des applications.\n\nAppuyez longuement sur une application pour accéder aux paramètres spécifiques à l'application, aux correctifs et pour ajouter l'application à l'écran d'accueil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta la modalità JITLess nelle impostazioni per utilizzare LiveContainer senza JIT.\n\n**Controlla la pagina JITLess Diagnose nelle impostazioni se hai problemi ad abilitare la modalità JITLess. *\n\nPremi il pulsante plus per installare le applicazioni.\n\nPremi a lungo l'app per le impostazioni, le correzioni e l'aggiunta di app alla schermata iniziale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定でJITレスモードを設定して、JITなしでLiveContainerを使用します。\n\n**JITレスモードを有効化する際に問題がある場合は、設定内のJITレス診断ページを確認してください。**\n\nアプリをインストールするには、｢＋｣ ボタンを押してください。\n\nアプリ固有の設定、修正、ホーム画面にアプリを追加するには、アプリを長押ししてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JIT 없이 LiveContainer를 사용하려면 JIT-Less 모드를 활성화하세요.\n\n**JIT-Less 모드 활성화 도중 문제가 있을 경우 JIT-Less 모드 진단을 활용해보세요.**\n\n앱을 설치하려면 +를 누르세요.\n\n앱을 홈 화면에 추가하거나, 앱 설정을 열고 싶으면 앱을 길게 누르세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw tryb JIT-Less w ustawieniach aby używać LiveContainer bez JIT/\n\n**Sprawdź stronę Diagnozy JIT-Less jeśli masz problemy włączając tą funkcje.**\n\nNaciśnij + aby instalować aplikacje\n\nPrzytrzymując baner aplikacji, będzie dostępne menu z ustawieniami dotyczącej aplikacji oraz dodawanie aplikacji do ekranu początkowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure o modo JIT-Less (requer SideStore/AltStore) nas configurações para usar o LiveContainer.\n\n**Verifique a página de diagnóstico do modo JIT-Less nas configurações se você encontrar problemas ativando-o.**\n\nPressione o sinal de '+' para adicionar e instalar aplicativos.\n\nPressione e segure o aplicativo para alterar sua configuração, corrigir erros e adicionar aplicativos à tela de início."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы собираетесь использовать LiveContainer без JIT, установите режим JIT-less в настройках.\n\n**Воспользуйтесь диагностикой режима JIT-less в настройках, если вы сталкиваетесь с проблемами.**\n\nНажмите на кнопку '+', чтобы установить приложение.\n\nНажмите и удерживайте приложение для настроек и исправлений, связанных с ним, а также чтобы добавить его на домашний экран."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurera JITLess i inställningar för att använda LiveContainer utan JIT.\n\n**Kontrollera JITLess diagnostisera sidan i inställningar om du har problem med att aktivera JITLess läge. **\n\nTryck på plusknappen för att installera appar.\n\nTryck länge på appen för appspecifika inställningar, fixar och lägger till appar på startskärmen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JIT olmadan LiveContainer'ı kullanmak için ayarlarda JITLess modunu etkinleştirin.\n\n**JITLess modunu etkinleştirirken sorun yaşıyorsanız, ayarlardaki JITLess Teşhis sayfasını kontrol edin.**\n\nUygulamaları yüklemek için artı düğmesine basın.\n\nUygulamaya özgü ayarlar, düzeltmeler ve uygulamaları ana ekrana eklemek için uygulamaya uzun basın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết lập chế độ JITLess trong cài đặt để dùng LiveContainer không JIT.\n\n**Kiểm tra trang Chuẩn đoán JITLess trong cài đặt nếu bạn gặp vấn đề khi dùng chế độ này.**\n\nNhấn vào dấu cộng để cài thêm app.\n\nNhấn giữ app để mở cài đặt của app, các sửa lỗi và thêm app vào màn hình chính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设置中配置免JIT模式来使得LiveContainer无需JIT权限即可使用。\n\n**如果配置免JIT模式时遇到问题，请查看免JIT模式诊断页面。**\n\n点击加号按钮来安装App。\n\n长按App可查看App设置，修复App问题，以及将App添加到主屏幕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在設定中設定免JIT模式來使得LiveContainer無需JIT即可使用。\n\n**如果在設定免JIT模式時遇到問題，請查看免JIT模式診斷頁面。 **\n\n點選加號按鈕來安裝App。\n\n長按App可以查看App設置、修復App問題、和將App添加至主畫面。"
          }
        }
      }
    },
    "lc.helpView.text2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أفحص [الأسئلة المتكررة LiveContainer]\n(https://github.com/khanhduytran0/LiveContainer/issues/265) للأخطاء الشائعة.\n\nوأذا واجهت مشكله أو مشكله توافق الرجاء إرسال طلب مساعده او شكوى في [Github]\n(https://github.com/khanhduytran0/LiveContainer/issues)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Häufige Probleme finden Sie unter [LiveContainer FAQ](https://github.com/khanhduytran0/LiveContainer/issues/265).**\n                         \nWenn Sie einen Fehler oder ein Kompatibilitätsproblem feststellen, melden Sie dies bitte unter [GitHub issues](https://github.com/khanhduytran0/LiveContainer/issues)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Check [LiveContainer FAQ](https://github.com/khanhduytran0/LiveContainer/issues/265) for common issues.**\n                         \nIf you encounter a bug or compatibility issue please submit on [GitHub issues](https://github.com/khanhduytran0/LiveContainer/issues)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Comprueba [LiveContainer FAQ](https://github.com/khanhduytran0/LiveContainer/issues/265) para problemas comunes.**\n                         \nSi encuentras un error o un problema de compatibilidad, por favor envíalo en [GitHub issues](https://github.com/khanhduytran0/LiveContainer/issues)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Consultez la [FAQ de LiveContainer](https://github.com/khanhduytran0/LiveContainer/issues/265) (en anglais) pour voir les problèmes courants.\n                         \nSi vous rencontrez un bug ou un problème de compatibilité, veuillez le soumettre sur [GitHub](https://github.com/khanhduytran0/LiveContainer/issues)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Controlla [LiveContainer FAQ](https://github.com/khanhduytran0/LiveContainer/issues/265) per problemi comuni.**\n                         \nSe riscontri un problema di bug o compatibilità, invia su [problemi GitHub](https://github.com/khanhduytran0/LiveContainer/issues)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般的な問題は[LiveContainer FAQ](https://github.com/khanhduytran0/LiveContainer/issues/265)を確認してください。\n\nバグや互換性の問題が発生した場合は[GitHub Issues](https://github.com/khanhduytran0/LiveContainer/issues)に報告してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**자주 묻는 질문은 [LiveContainer FAQ](https://github.com/khanhduytran0/LiveContainer/issues/265)를 확인해주세요.**\n                         \n버그나 호환성 문제는 [GitHub issues](https://github.com/khanhduytran0/LiveContainer/issues)에 보고해주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Zobacz [Często Zadawane Pytania dotyczące problemów z LiveContainer](https://github.com/khanhduytran0/LiveContainer/issues/265)**\n\nJeśli napotkasz błąd czy problem z kompatybilnością, Proszę o złożenie wniosku na portalu [GitHub issues](https://github.com/khanhduytran0/LiveContainer/issues)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Verifique as [Perguntas frequentes do LiveContainer](https://github.com/khanhduytran0/LiveContainer/issues/265) para as possíveis soluções para seus problemas.**\n\nSe você encontrar um erro técnico ou um problema na compatibilidade do LiveContainer por favor relate isso na [Página de problemas no GitHub](https://github.com/khanhduytran0/LiveContainer/issues)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Загляните в [ЧАВО LiveContainer'а](https://github.com/khanhduytran0/LiveContainer/issues/265) для решений на частые проблемы**\n                      \nЕсли вы обнаружили баг и проблему с совместимостью, то отправьте его на [GitHub issues](https://github.com/khanhduytran0/LiveContainer/issues)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Kontrollera [Vanliga frågor om LiveContainer](https://github.com/khanhduytran0/LiveContainer/issues/265) för vanliga problem.**\n                         \nOm du stöter på ett fel eller kompatibilitetsproblem vänligen skicka in [GitHub-problem](https://github.com/khanhduytran0/LiveContainer/issues)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Sık karşılaşılan sorunlar için [LiveContainer SSS](https://github.com/khanhduytran0/LiveContainer/issues/265) bölümünü kontrol edin.**\n                         \nBir hata veya uyumluluk sorunu ile karşılaşırsanız, lütfen [GitHub sorunları](https://github.com/khanhduytran0/LiveContainer/issues) bölümüne bildirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Vào [LiveContainer FAQ](https://github.com/khanhduytran0/LiveContainer/issues/265) để xem các lỗi thường gặp.**\n                         \nNếu bạn gặp lỗi hay vấn đề tương thích vui lòng gửi vào [GitHub issues](https://github.com/khanhduytran0/LiveContainer/issues)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**遇到问题时请先查看[LiveContainer常见问题（英语）](https://github.com/khanhduytran0/LiveContainer/issues/265)。**\n                         \n如果你遇到Bug或者App兼容性问题，请到[GitHub issues](https://github.com/khanhduytran0/LiveContainer/issues)提交。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "                         **遇到問題時請先查看[LiveContainer常見問題（英文）](https://github.com/khanhduytran0/LiveContainer/issues/265)。 **\n                         \n如果您遇到Bug或是App相容性問題，請至[GitHub issues](https://github.com/khanhduytran0/LiveContainer/issues)提交錯誤。"
          }
        }
      }
    },
