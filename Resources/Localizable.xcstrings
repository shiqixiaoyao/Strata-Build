          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm Thùng chứa Bộ nhớ Ngoài"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加非本地容器"
          }
        },
